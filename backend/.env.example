# Copie este arquivo para ".env" e ajuste os valores conforme necessário.

# Banco de dados
# Padrão (zero configuração): SQLite, cria o arquivo vacinapp.db automaticamente.
DATABASE_URL=sqlite:///./vacinapp.db

# Para usar MySQL (ex: via MySQL Workbench, seguindo backend/database/schema.sql):
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/vacinapp

# Segurança do token de acesso (JWT). Troque por um valor aleatório em produção.
JWT_SECRET_KEY=troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# CORS: "*" libera qualquer origem (bom para desenvolvimento com Expo Go)
CORS_ALLOW_ORIGINS=*

APP_NAME=VacinApp API
ENVIRONMENT=development

# IA Local (Ollama)
# O backend roda no mesmo PC que o Ollama, então "localhost" funciona diretamente.
# Se mover o backend para outro servidor, ajuste OLLAMA_URL para o IP da máquina com o Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
